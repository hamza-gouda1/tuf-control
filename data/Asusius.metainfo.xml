<component type="desktop-application">
  <id>io.github.hamzagouda.Asusius</id>
  <metadata_license>CC0-1.0</metadata_license>
  <url type="homepage">https://github.com/hamza-gouda1/asusius</url>
  <url type="bugtracker">https://github.com/hamza-gouda1/asusius/issues</url>
  <url type="vcs-browser">https://github.com/hamza-gouda1/asusius</url>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Asusius</name>
  <summary>Fans, power, graphics and lighting for ASUS laptops</summary>
  <developer id="io.github.hamzagouda">
    <name>Hamza Gouda</name>
  </developer>
  <description>
    <p>
      A native GNOME control centre for ASUS TUF and ROG laptops: live sensors, power
      profiles, fan curves, GPU mode switching, charge limit, display refresh rate and
      keyboard lighting. Every write is checked against the firmware's own limits.
    </p>
  </description>
  <launchable type="desktop-id">io.github.hamzagouda.Asusius.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <caption>Dashboard with live processor, graphics and battery readings</caption>
