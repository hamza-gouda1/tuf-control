      <image type="source">https://raw.githubusercontent.com/hamza-gouda1/asusius/main/docs/screenshots/performance-dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Keyboard lighting effects and their preview</caption>
      <image type="source">https://raw.githubusercontent.com/hamza-gouda1/asusius/main/docs/screenshots/keyboard-effects-dark.png</image>
    </screenshot>
  </screenshots>
